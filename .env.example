# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# Jika dikosongkan, aplikasi berjalan dengan data simulasi + filter berbasis aturan.

# --- Sumber berita (GNews: https://gnews.io) ---
GNEWS_API_KEY=

# --- Relevance Engine (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database riwayat (Supabase). Jalankan supabase/schema.sql terlebih dulu ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Proteksi endpoint cron (Vercel Cron mengirim header Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

