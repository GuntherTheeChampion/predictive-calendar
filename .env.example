# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# Berita nyata ditarik otomatis dari Google News RSS Indonesia (tanpa perlu API Key).

# --- Database riwayat (Supabase). Jalankan supabase/schema.sql terlebih dulu di SQL Editor Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Opsional: Service Role Key (jika tidak diisi, sistem menggunakan NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# --- Opsional: Sumber berita tambahan (GNews: https://gnews.io) ---
GNEWS_API_KEY=

# --- Opsional: Relevance Engine LLM (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Proteksi endpoint cron (Vercel Cron mengirim header Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=
